# Groq API Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Vectorize Memory Configuration
# Docs: https://hindsight.vectorize.io/
# Endpoint can be Cloud (e.g., https://api.hindsight.vectorize.io) or local instance (e.g., http://localhost:8888)
HINDSIGHT_ENDPOINT=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Default memory bank ID for the meeting prep agent
HINDSIGHT_BANK_ID=meeting-prep-agent
